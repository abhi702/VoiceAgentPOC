# Copy to .env in THIS folder. Never paste real patient data into this POC.
# No Azure deployment, subscription ID or tenant ID is needed by the application.
APP_ENV=development
NEXT_TELEMETRY_DISABLED=1
ALLOWED_ORIGIN=http://localhost:3000

# Generate your own random local passwords/token; these are not cloud credentials.
MYSQL_ROOT_PASSWORD=change-this-local-root-password
MYSQL_DATABASE=gp_clinic
MYSQL_USER=clinic_user
MYSQL_PASSWORD=change-this-local-database-password
CLINIC_API_TOKEN=change-this-to-a-long-random-local-token

# Required for microphone input and spoken output. Azure Portal > Speech > Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uksouth
AZURE_SPEECH_LOCALE=en-GB
AZURE_TTS_VOICE=en-GB-SoniaNeural
VAD_ENABLED=true

# At least one model provider is required for free-form conversation.
# GitHub PAT with Models read permission. Model availability depends on your account.
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
PRIMARY_REASONING_MODEL=openai/gpt-4o

# Optional fast provider; omit to use GitHub Models for all turns.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
FAST_ROUTER_MODEL=llama-3.3-70b-versatile

# Local search is the default. First use downloads the public embedding model.
# Enable Azure only after creating an index using the documented ingest command.
RAG_MODE=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=clinic-sop-index

# Host-run defaults. Docker Compose overrides service addresses internally.
REDIS_URL=redis://localhost:6379/0
MYSQL_HOST=localhost
MYSQL_PORT=3306
NESTJS_BACKEND_URL=http://localhost:3001
ORCHESTRATOR_PORT=8000
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8000
NEXT_PUBLIC_NESTJS_API_URL=http://localhost:3001
